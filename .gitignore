# =============================================================================
# SECRETS & ENVIRONMENT VARIABLES
# =============================================================================
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/


# Virtual environments
venv/
.venv/
env/
ENV/

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Test artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.log

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / flake8 / pylint caches
.ruff_cache/
.pylintrc_cache

# Jupyter (if data science work lands in the repo)
.ipynb_checkpoints/
*.ipynb

# Celery beat schedule file (future: background tasks)
celerybeat-schedule
celerybeat.pid

# SQLite (local dev fallback DB)
*.sqlite3
*.db



# DATA & UPLOADS  
data/uploads/
data/exports/
data/backups/
data/cache/
data/raw/
*.csv
*.json.gz
*.parquet
*.pkl
*.pickle

# Keep placeholder so the `data/` folder itself is tracked
!data/.gitkeep


# =============================================================================
# DOCKER
# =============================================================================
# Don't ignore docker-compose.yml (it's safe — no secrets, uses env vars)
# DO ignore local overrides that may contain secrets
docker-compose.override.yml
docker-compose.local.yml
.dockerignore


